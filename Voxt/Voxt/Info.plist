<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleDisplayName</key>
    <string>SayIt</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <!-- Prevent released MLX weight pages from remaining in libmalloc's large-object cache. -->
    <key>LSEnvironment</key>
    <dict>
        <key>MallocSpaceEfficient</key>
        <string>1</string>
    </dict>
    <key>NSAppleEventsUsageDescription</key>
    <string>SayIt needs automation access to read the active browser tab URL for app branch enhancement.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>SayIt needs system audio access to capture meeting audio and to temporarily mute other apps while recording.</string>
    <key>NSHumanReadableCopyright</key>
    <string></string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>SayIt needs microphone access to transcribe your speech.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>SayIt needs reminders access to sync notes into Apple Reminders.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>SayIt captures the current app window screenshot to improve transcription enhancement when app context is enabled.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>SayIt uses speech recognition for direct dictation.</string>
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <!-- Silent background download; user explicitly installs via in-app "Install and Restart". -->
    <key>SUAutomaticallyUpdate</key>
    <true/>
    <key>SUEnableAutomaticChecks</key>
    <true/>
	<key>SUFeedURL</key>
	<string>https://sayit-sparkle-update.edgeone.cool/updates/stable/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <!-- Must match GitHub secret SPARKLE_PRIVATE_KEY / local Keychain ed25519 seed. -->
    <string>1jLVHTAcmIr8zHAv8z91XK0/OFRat4n74n6fDgQC8C4=</string>
</dict>
</plist>
