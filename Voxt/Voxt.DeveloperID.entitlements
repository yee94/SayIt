<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Developer ID distribution entitlements for SayIt/Voxt migration builds.
	  Must stay aligned with Voxt.entitlements: no App Sandbox, no restricted
	  identity keys (application-identifier / keychain-access-groups).
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
